/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), geolocation=(self), microphone=()

/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
